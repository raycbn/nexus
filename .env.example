# NEXUS Environment Configuration
# Copy this file to .env and fill in values for your environment.

# --- Application ---
APP_ENVIRONMENT=local
APP_DEBUG=true
AUTO_MIGRATE=true
# Development shortcut only. Set true to auto-create the local admin.
AUTO_BOOTSTRAP=false

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
ALLOWED_ORIGINS=http://localhost:8080
WEB_PORT=8080

# --- Security ---
SECRET_KEY=change-me-in-production-use-a-long-random-string
API_TOKEN_SALT=change-me-in-production

# --- JWT/Authentication ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- LLM / Ollama ---
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=hf.co/Qwen/Qwen3-4B-GGUF:Q4_K_M
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=120

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nexus:nexus@host.docker.internal:5433/nexus

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Linux Lab (local development infrastructure) ---
# Path to a local private SSH key file (gitignored; never store key contents).
# Used by the LinuxConnector to reach the Docker-based linux-lab-01 target.
LAB_SSH_HOST=localhost
LAB_SSH_PORT=2222
LAB_SSH_USERNAME=nexus
LAB_SSH_KEY_PATH=infrastructure/lab/ssh_key

# --- Linux Lab Application (exposed inside the lab container) ---
LAB_APP_BASE_URL=http://localhost
LAB_APP_SLOW_SECONDS=2

# --- Multi-Tenancy ---
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000002
NEXUS_AUTONOMOUS_HIGH_RISK=false

# --- Remediation safety ---
REMEDIATION_KILL_SWITCH=true
REMEDIATION_WRITES_ENABLED=false
REMEDIATION_LAB_ONLY=true

# --- Encrypted credential vault ---
# Generate a random 32-byte key and encode it with URL-safe base64.
NEXUS_VAULT_MASTER_KEY=generate-a-32-byte-base64-key

# Billing / Stripe (optional until payments are enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=http://localhost:3000/billing?success=1
BILLING_CANCEL_URL=http://localhost:3000/billing?cancelled=1
