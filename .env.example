# NEXUS Environment Configuration
# Copy this file to .env and fill in values for your environment.

# --- Application ---
APP_ENVIRONMENT=local
APP_DEBUG=true

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# --- Security ---
SECRET_KEY=change-me-in-production-use-a-long-random-string
API_TOKEN_SALT=change-me-in-production

# --- LLM / Ollama ---
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=hf.co/Qwen/Qwen3-4B-GGUF:Q4_K_M
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=120

# --- Database (not yet used in v0.1) ---
# DATABASE_URL=sqlite:///./nexus.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Linux Lab (local development infrastructure) ---
# Path to a local private SSH key file (gitignored; never store key contents).
# Used by the LinuxConnector to reach the Docker-based linux-lab-01 target.
LAB_SSH_HOST=localhost
LAB_SSH_PORT=2222
LAB_SSH_USERNAME=nexus
LAB_SSH_KEY_PATH=infrastructure/lab/ssh_key

# --- Linux Lab Application (exposed inside the lab container) ---
LAB_APP_BASE_URL=http://localhost
LAB_APP_SLOW_SECONDS=2

# --- Multi-Tenancy ---
DEFAULT_ORGANIZATION_ID=org-local-dev
